---
// src/pages/index.astro

const slides = [
  {
    text: "I am a Full-Stack web developer for both frontend and backend web development applications, for both websites and mobile apps. I can manage the entire project, whether we do a custom build or use 3rd-party website management software.",
    links: []
  },
  {
    text: "I can turn any existing design into pure frontend code for a website, webpage, or mobile app using vanilla coding languages, or if preferred, popular webpage builders, including wordpress .",
    links: []
  },
  {
    text: "I can debug and fix any javascript, php, css, or html code for issues, including plugins, themes, or any other online tools used today that work with those languages.",
    links: [], // Added fallback so the build succeeds while your credentials stay commented out!
    /* PUT CREDENTIALS HERE IN FUTURE ONCE GET THEM:
    links: [
      { name: "AWS Certified Solutions Architect - Professional", url: "https://your-credential-link.com" },
      { name: "Cloudflare Certified Professional Security Engineer", url: "https://your-credential-link.com" },
      { name: "HashiCorp Certified: Terraform Associate", url: "https://your-credential-link.com" }
    ]
    */
  }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Career Profile & Specializations</title>
		<style is:global>
			html, body {
				margin: 0 !important;
				padding: 0 !important;
				width: 100% !important;
				height: 100% !important;
				overflow: hidden !important;
				background-color: #030303 !important;
			}

			.slider-container {
				position: relative;
				width: 100vw;
				height: 100vh;
				display: flex;
				align-items: center;
				justify-content: center;
				font-family: system-ui, sans-serif;
				color: #f3f4f6;
				background-color: #030303 !important;
				
				/* NEW BRIGHT COMET GRADIENT (Opacities boosted to 85%-95% so they are obvious) */
				background-image: linear-gradient(
					135deg, 
					rgba(135, 206, 235, 0.90) 0%,   /* Neon Sky Blue Comet Head */
					rgba(186, 147, 219, 0.85) 20%,  /* Light Purple Middle */
					rgba(255, 182, 193, 0.80) 45%,  /* Light Pink Tail */
					rgba(3, 3, 3, 1.00) 70%         /* Fades out completely to deep space black */
				) !important;
				background-attachment: fixed;
			}

			.slides-inner {
				width: 100%;
				height: 100%;
				position: relative;
			}

			.slide {
				position: absolute;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: center;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.5s ease-in-out;
				padding: 0 10%;
				box-sizing: border-box;
			}

			.slide.active {
				opacity: 1;
				pointer-events: auto;
			}

			.slide-content {
				max-width: 800px;
				text-align: left;
			}

			.description-text {
				font-size: 2.5rem;
				line-height: 1.4;
				font-weight: 600;
				letter-spacing: -0.02em;
				margin-bottom: 2rem;
				color: #ffffff;
				/* Heavy drop shadow so text remains highly readable over the bright comet colors */
				text-shadow: 0 4px 15px rgba(0, 0, 0, 0.9), 0 2px 4px rgba(0, 0, 0, 0.9);
			}

			@media (max-width: 768px) {
				.description-text {
					font-size: 1.75rem;
				}
			}

			.certifications-container {
				display: flex;
				flex-direction: column;
				gap: 1rem;
			}

			.cert-link {
				display: inline-block;
				color: #030303; /* Dark text so it pops against the light pink gradient tail */
				background: rgba(255, 255, 255, 0.8);
				padding: 0.5rem 1rem;
				border-radius: 4px;
				text-decoration: none;
				font-size: 1.2rem;
				font-weight: 600;
				width: fit-content;
				box-shadow: 0 4px 6px rgba(0,0,0,0.1);
				transition: all 0.2s ease;
			}

			.cert-link:hover {
				background: #ffffff;
				transform: translateX(5px);
				box-shadow: 0 6px 12px rgba(0,0,0,0.2);
			}

			/* Combined Nav Container on the right-center */
			.nav-group-container {
				position: absolute;
				right: 2rem;
				top: 50%;
				transform: translateY(-50%);
				display: flex;
				align-items: center;
				gap: 1rem;
				z-index: 10;
				cursor: pointer;
			}

			/* Read More Text Styles */
			.read-more-text {
				font-size: 1.25rem;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				user-select: none;
				text-shadow: 0 2px 10px rgba(0, 0, 0, 0.9);
				/* Apply the color animation */
				animation: cosmicPulse 1s infinite ease-in-out;
			}

			.nav-arrow {
				background: rgba(0, 0, 0, 0.7); /* Darker mask for contrast */
				border: 1px solid rgba(255, 255, 255, 0.2);
				cursor: pointer;
				width: 3.5rem;
				height: 3.5rem;
				display: flex;
				align-items: center;
				justify-content: center;
				border-radius: 50%;
				box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.9);
				transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
				/* Apply the identical color animation to the arrow stroke */
				animation: cosmicPulse 1s infinite ease-in-out;
			}

			/* Synchronized Color Transition Animation */
			@keyframes cosmicPulse {
				0%, 100% {
					color: #ffffff;
					fill: transparent;
				}
				45% {
					color: #ffffff;
					fill: transparent;
				}
				/* Sharp split-second color snap down to the sky blue hex */
				50%, 95% {
					color: #87ceeb;
					filter: drop-shadow(0 0 8px rgba(135, 206, 235, 0.8));
				}
			}

			/* Hover State Controls */
			.nav-group-container:hover .nav-arrow {
				background-color: #0a0a0a;
				border-color: #ffffff;
				transform: scale(1.15);
				box-shadow: 
					0 15px 30px -5px rgba(0, 0, 0, 0.95), 
					0 0 25px 5px rgba(255, 255, 255, 0.6), 
					inset 0 0 8px rgba(255, 255, 255, 0.4);
				animation-play-state: paused; /* Locks to white reflection on mouse hover */
				color: #ffffff !important;
			}

			.nav-group-container:hover .read-more-text {
				color: #ffffff !important;
				text-shadow: 0 0 12px rgba(255, 255, 255, 0.6);
				animation-play-state: paused;
			}

			.nav-arrow svg {
				width: 2rem;
				height: 2rem;
			}
		</style>
	</head>
	<body>

		<main class="slider-container">
			<div class="slides-inner">
				{slides.map((slide, index) => (
					<section class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
						<div class="slide-content">
							<p class="description-text">{slide.text}</p>
							
							{slide.links && slide.links.length > 0 && (
								<div class="certifications-container">
									{slide.links.map(link => (
										<a href={link.url} target="_blank" rel="noopener noreferrer" class="cert-link">
											{link.name} &rarr;
										</a>
									))}
								</div>
								
							)}
						</div>
					</section>
				))}
			</div>

			<!-- Unified Clickable Control Group -->
			<div id="next-arrow-group" class="nav-group-container">
				<span class="read-more-text">Read More</span>
				<button class="nav-arrow" aria-label="Next Slide">
					<svg xmlns="w3.org" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
						<path d="m9 18 6-6-6-6"/>
					</svg>
				</button>
			</div>
		</main>

		<script>
			const slides = document.querySelectorAll('.slide');
			const nextBtnGroup = document.getElementById('next-arrow-group');
			let currentIndex = 0;

			nextBtnGroup?.addEventListener('click', () => {
				slides[currentIndex].classList.remove('active');
				currentIndex = (currentIndex + 1) % slides.length;
				slides[currentIndex].classList.add('active');
			});
		</script>

	</body>
</html>
