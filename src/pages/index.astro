---
// src/pages/test.astro
// Clean AJAX baseline test to completely bypass Astro's 405 routing block
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baseline Test</title>
</head>
<body style="background-color: #111827; color: #f3f4f6; font-family: sans-serif; padding: 4rem; max-width: 500px; margin: 0 auto;">

    <h2>Web3Forms Baseline Test</h2>
    
    <!-- Notice we removed the action/method here so the browser won't trigger a 405 intercept crash -->
    <form id="baseline-test-form" novalidate>
        <input type="hidden" id="form-key" value="38736f3d-a04b-4eaa-9667-4f4d2f977b83" />
        
        <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: .5rem;">
            <label style="font-weight: 600;">Name:</label>
            <input type="text" id="form-name" style="background-color: #1f2937; border: 1px solid #374151; padding: .75rem; color: #fff; border-radius: 6px;" required />
        </div>

        <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: .5rem;">
            <label style="font-weight: 600;">Email:</label>
            <input type="email" id="form-email" style="background-color: #1f2937; border: 1px solid #374151; padding: .75rem; color: #fff; border-radius: 6px;" required />
        </div>
        
        <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: .5rem;">
            <label style="font-weight: 600;">Message:</label>
            <textarea id="form-message" style="background-color: #1f2937; border: 1px solid #374151; padding: .75rem; color: #fff; border-radius: 6px; height: 100px;" required></textarea>
        </div>
        
        <button type="submit" style="background-color: #3b82f6; color: #fff; border: none; padding: .75rem 1.5rem; font-weight: 700; border-radius: 6px; cursor: pointer; width: 100%;">
            Submit Raw Test
        </button>
    </form>

    <script>
        const testForm = document.getElementById('baseline-test-form');
        
        testForm?.addEventListener('submit', (e) => {
            e.preventDefault(); // This explicitly stops Astro from throwing that 405 error!

            const accessKey = document.getElementById('form-key').value;
            const name = document.getElementById('form-name').value;
            const email = document.getElementById('form-email').value;
            const message = document.getElementById('form-message').value;

            // Send the raw baseline fields via clean JSON string formatting
            fetch("https://web3forms.com", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Accept": "application/json"
                },
                body: JSON.stringify({
                    access_key: accessKey,
                    name: name,
                    email: email,
                    message: message
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    alert("Success! Web3Forms accepted the baseline data payload.");
                    testForm.reset();
                } else {
                    alert("Web3Forms API Error: " + data.message);
                }
            })
            .catch(error => {
                console.error("Transmission Error:", error);
                alert("Network communication drop.");
            });
        });
    </script>

</body>
</html>
