---
// src/pages/test.astro
// Isolated Minimal Testing Page
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Baseline Form Test</title>
</head>
<body style="background-color: #111827; color: #f3f4f6; font-family: sans-serif; padding: 4rem; max-width: 500px; margin: 0 auto;">

    <h2 style="border-bottom: 1px solid #374151; padding-bottom: 1rem; margin-bottom: 2rem;">Web3Forms Isolated Test</h2>
    
    <form action="https://web3forms.com" method="POST">
        <!-- Core Config Tokens -->
        <input type="hidden" name="access_key" value="38736f3d-a04b-4eaa-9667-4f4d2f977b83" />
        <input type="hidden" name="redirect" value="https://lorikelley.dev" />
        
        <div style="margin-bottom: 1.5rem; display: flex; flex-direction: column; gap: .5rem;">
            <label style="font-weight: 600;">Name:</label>
            <input type="text" name="name" style="background-color: #1f2937; border: 1px solid #374151; padding: .75rem; color: #fff; border-radius: 6px;" required />
        </div>
        
        <div style="margin-bottom: 2rem; display: flex; flex-direction: column; gap: .5rem;">
            <label style="font-weight: 600;">Test Message:</label>
            <textarea name="message" style="background-color: #1f2937; border: 1px solid #374151; padding: .75rem; color: #fff; border-radius: 6px; height: 100px;" required></textarea>
        </div>
        
        <button type="submit" style="background-color: #3b82f6; color: #fff; border: none; padding: .75rem 1.5rem; font-weight: 700; border-radius: 6px; cursor: pointer; width: 100%;">
            Submit Raw Test
        </button>
    </form>

</body>
</html>
